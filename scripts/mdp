#!/usr/bin/env python3
"""mdp — render a markdown file and open it in a browser.

Static one-shot render: writes HTML to a temp file (stable per input path,
so re-runs overwrite) and opens it in a browser. Shares rendering with
md-preview-server.py via _renderer.

Config (~/.config/md-preview/config.toml, all keys optional):

    theme      = "dark"        # "dark" or "light"
    font_size  = 18            # body font-size in px
    custom_css = "~/path.css"  # appended after defaults; cascade wins
    browser    = "auto"        # "auto" | command string | array of args
                               # The URL is appended as the last arg.
                               # auto = chrome --app= → xdg-open/open

CLI flags override config. XDG_CONFIG_HOME is respected.
"""

import argparse
import hashlib
import os
import shutil
import subprocess
import sys
import tempfile

# _renderer lives next to this script; resolve symlinks so PATH installs work.
sys.path.insert(0, os.path.dirname(os.path.abspath(os.path.realpath(__file__))))

from _renderer import render_body, build_page  # noqa: E402

try:
    import tomllib  # 3.11+
except ModuleNotFoundError:
    tomllib = None


# ── Config ────────────────────────────────────────────────────────────────
def _config_path() -> str:
    base = os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config")
    return os.path.join(base, "md-preview", "config.toml")


def load_config() -> dict:
    path = _config_path()
    if not os.path.isfile(path) or tomllib is None:
        return {}
    with open(path, "rb") as f:
        try:
            return tomllib.load(f)
        except tomllib.TOMLDecodeError as e:
            print(f"mdp: config parse error in {path}: {e}", file=sys.stderr)
            return {}


def load_extra_css(cfg: dict) -> str:
    parts = []

    size = cfg.get("font_size")
    if size is not None:
        if isinstance(size, (int, float)) and size > 0:
            parts.append(f"body {{ font-size: {size}px; }}")
        else:
            print(f"mdp: invalid 'font_size' in config: {size!r}", file=sys.stderr)

    p = cfg.get("custom_css")
    if p:
        p = os.path.expanduser(p)
        if os.path.isfile(p):
            with open(p, encoding="utf-8") as f:
                parts.append(f.read())
        else:
            print(f"mdp: custom_css not found: {p}", file=sys.stderr)

    return "\n".join(parts)


# ── Browser ───────────────────────────────────────────────────────────────
def _auto_browser_cmd(url: str) -> list[str]:
    for c in ("google-chrome", "chromium", "chromium-browser"):
        p = shutil.which(c)
        if p:
            return [p, f"--app={url}"]
    if sys.platform == "darwin":
        return ["open", url]
    return ["xdg-open", url]


def browser_cmd(cfg_browser, url: str) -> list[str]:
    if cfg_browser in (None, "", "auto"):
        return _auto_browser_cmd(url)
    if isinstance(cfg_browser, str):
        return [*cfg_browser.split(), url]
    if isinstance(cfg_browser, list):
        return [*cfg_browser, url]
    print(f"mdp: invalid 'browser' in config: {cfg_browser!r}", file=sys.stderr)
    return _auto_browser_cmd(url)


# ── Main ──────────────────────────────────────────────────────────────────
def main():
    cfg = load_config()

    p = argparse.ArgumentParser(prog="mdp", description="Render a markdown file in a browser.")
    p.add_argument("file", help="Path to a markdown file")
    p.add_argument("-t", "--theme", choices=("dark", "light"), default=None,
                   help="Override theme from config (default: dark)")
    p.add_argument("-p", "--print", dest="print_path", action="store_true",
                   help="Print HTML path instead of opening a browser")
    args = p.parse_args()

    src = os.path.abspath(args.file)
    if not os.path.isfile(src):
        print(f"mdp: file not found: {src}", file=sys.stderr)
        sys.exit(1)

    theme = args.theme or cfg.get("theme") or "dark"
    if theme not in ("dark", "light"):
        print(f"mdp: invalid theme {theme!r}, using 'dark'", file=sys.stderr)
        theme = "dark"

    body = render_body(src)
    page = build_page(body, theme, extra_css=load_extra_css(cfg))

    digest = hashlib.sha1(src.encode()).hexdigest()[:12]
    out = os.path.join(tempfile.gettempdir(), f"mdp-{digest}.html")
    with open(out, "w", encoding="utf-8") as f:
        f.write(page)

    if args.print_path:
        print(out)
        return

    cmd = browser_cmd(cfg.get("browser"), f"file://{out}")
    subprocess.Popen(
        cmd,
        start_new_session=True,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )


if __name__ == "__main__":
    main()
